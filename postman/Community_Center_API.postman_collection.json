      "name": "01 - Centros Comunitários",
      "item": [
        {
          "name": "Criar Centro Comunitário (Sucesso)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Retorna communityCenterId válido', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('communityCenterId');",
                  "    pm.expect(jsonData.communityCenterId).to.be.a('string').and.not.empty;",
                  "    // Salva nas variáveis da collection para testes subsequentes",
                  "    pm.collectionVariables.set('communityCenterId', jsonData.communityCenterId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Centro Postman QA {{$randomAlphaNumeric}}\",\n  \"address\": \"Av. Teste Postman, 123\",\n  \"maxNumberOfPeople\": 200,\n  \"currentNumberOfPeople\": 50,\n  \"resources\": {\n    \"doctor\": 3,\n    \"volunteer\": 10,\n    \"medicalSuppliesKit\": 5,\n    \"transportVehicle\": 2,\n    \"basicFoodBasket\": 20\n  }\n}"
